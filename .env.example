# ═══════════════════════════════════════════════════════════
# HackAtlas Frontend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# Vite requires the VITE_ prefix to expose vars to the client bundle.

# Supabase project URL (e.g. https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase ANON (public) key — safe to expose client-side.
# RLS policies restrict this key to read-only access on the hackathons table.
# Found in: Supabase Dashboard → Settings → API → anon (public) key
#
# ⚠️  DO NOT put the service_role key here!
#     The service key has full write access and bypasses RLS.
#     It belongs ONLY in the backend pipeline (GitHub Secrets).
VITE_SUPABASE_ANON_KEY=
