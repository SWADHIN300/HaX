# ═══════════════════════════════════════════════════════════
# HackAtlas Backend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.

# Supabase project URL (e.g. https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase service role key (NOT the anon key — needed for inserts)
# Found in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_KEY=

# ntfy.sh topic name for push notifications
# Create one at https://ntfy.sh/ — e.g. "hackatlas-alerts"
NTFY_TOPIC=
