# ═══════════════════════════════════════════════════════════
# HackAtlas Backend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# In CI (GitHub Actions), these are set as repository secrets.

# Supabase project URL (e.g. https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase SERVICE ROLE key — has full write access, bypasses RLS.
# Found in: Supabase Dashboard → Settings → API → service_role key
#
# ⚠️  This is NOT the anon key! The service key can read/write ALL tables.
#     • It must ONLY be used server-side (this pipeline / GitHub Actions).
#     • It must NEVER be exposed in the frontend bundle or committed to git.
#     • The frontend uses a separate ANON key (see root .env.example).
SUPABASE_SERVICE_KEY=

# ntfy.sh topic name for push notifications
# Pick an unguessable name (e.g. "hackatlas-alerts-a7x9k2")
# Install the ntfy app on your phone and subscribe to this topic
NTFY_TOPIC=
